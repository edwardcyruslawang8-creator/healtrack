# Uploaded patient document files live here on local disk (Firebase
# Cloud Storage isn't enabled for this project — see
# includes/shared/document_storage.php's header comment). This folder
# must never be served directly; every real download goes through
# api/download-document.php, which re-checks the signed-in user's
# access to the patient before streaming the file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
