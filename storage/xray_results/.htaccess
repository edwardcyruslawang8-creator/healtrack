# Uploaded X-ray result files live here on local disk (Firebase Cloud
# Storage isn't enabled for this project — see
# includes/shared/xray_result_storage.php's header comment). This
# folder must never be served directly; every real download/view goes
# through api/download-xray-result.php, which re-checks the signed-in
# user's role before streaming the file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>
